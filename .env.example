# ─────────────────────────────────────────────────────────────────────────────
# NagarNetra environment template
#   Local dev : cp .env.example .env.local   (git-ignored)
#   Vercel    : Project → Settings → Environment Variables (Production + Preview)
#
# Variables are split by exposure:
#   PUBLIC  (NEXT_PUBLIC_*) → bundled into browser JS, validated in lib/env/client.ts
#   SERVER  (everything else) → server-only, validated in lib/env/server.ts
# ─────────────────────────────────────────────────────────────────────────────

# ── PUBLIC ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Map default centre (lat,lng) — Bhubaneswar
NEXT_PUBLIC_MAP_CENTER=20.2961,85.8245

# ── SERVER: Supabase ─────────────────────────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=          # NEVER expose; bypasses RLS
SUPABASE_DB_URL=                    # optional: postgres connection string, only for running supabase/*.sql locally

# ── SERVER: AI providers ─────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite  # fast + good Odia; copy exact id from AI Studio
GROQ_API_KEY=                       # optional fallback
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_VISION_MODEL=qwen/qwen3.8-27b     # vision-capable model id from Groq console
GROQ_TEXT_MODEL=openai/gpt-oss-120b

# ── SERVER: City / geocoding ─────────────────────────────────────────────────
NOMINATIM_USER_AGENT="NagarNetra/1.0 (contact@example.com)"
CITY_NAME=Bhubaneswar
CITY_CODE=BBS
CITY_BBOX=                           # optional minLng,minLat,maxLng,maxLat (e.g. 85.70,20.18,85.95,20.42); empty = anywhere

# ── SERVER: Ops ──────────────────────────────────────────────────────────────
CRON_SECRET=                        # random string; Vercel Cron sends it as Bearer token
TELEGRAM_BOT_TOKEN=                 # optional — dept alerts for severity >= 4
